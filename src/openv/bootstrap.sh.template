#!/bin/sh
set -e

OPENV_VERSION="{{OPENV_VERSION}}"
DOTFILES_URL="{{DOTFILES_URL}}"

detect_pkg_manager() {
    if command -v brew > /dev/null 2>&1; then
        echo "brew"
    elif command -v apt-get > /dev/null 2>&1; then
        echo "apt-get"
    elif command -v opkg > /dev/null 2>&1; then
        echo "opkg"
    else
        echo ""
    fi
}

PKG_MANAGER=$(detect_pkg_manager)

if [ -z "$PKG_MANAGER" ]; then
    echo "ERROR: No supported package manager found (brew, apt-get, opkg)."
    exit 1
fi

install_prerequisites() {
    case "$PKG_MANAGER" in
        brew)
            brew install git python3
            ;;
        apt-get)
            sudo apt-get update -y
            sudo apt-get install -y git python3 python3-pip
            ;;
        opkg)
            sudo opkg update
            sudo opkg install git python3 python3-pip
            ;;
    esac
}

install_prerequisites

if [ -d "$HOME/.openv" ]; then
    echo "ERROR: $HOME/.openv already exists. Remove it before running bootstrap."
    exit 1
fi

git clone "$DOTFILES_URL" "$HOME/.openv"

pip3 install "openv==$OPENV_VERSION"

openv install
