#!/bin/sh
set -e

OPENV_VERSION="{{OPENV_VERSION}}"
DOTFILES_URL="{{DOTFILES_URL}}"

detect_pkg_manager() {
    if command -v brew > /dev/null 2>&1; then
        echo "brew"
    elif command -v apt-get > /dev/null 2>&1; then
        echo "apt-get"
    elif command -v opkg > /dev/null 2>&1; then
        echo "opkg"
    else
        echo ""
    fi
}

PKG_MANAGER=$(detect_pkg_manager)

if [ -z "$PKG_MANAGER" ]; then
    echo "ERROR: No supported package manager found (brew, apt-get, opkg)."
    exit 1
fi

install_prerequisites() {
    case "$PKG_MANAGER" in
        brew)
            brew install git python3
            ;;
        apt-get)
            run_as_root apt-get update -y
            run_as_root apt-get install -y git python3 python3-pip
            ;;
        opkg)
            run_as_root opkg update
            run_as_root opkg install git python3 python3-pip
            ;;
    esac
}

run_as_root() {
    if [ "$(id -u)" = "0" ]; then
        "$@"
    elif command -v sudo > /dev/null 2>&1; then
        sudo "$@"
    else
        echo "ERROR: Root privileges are required to install prerequisites. Run as root or install sudo." >&2
        exit 1
    fi
}

install_prerequisites

pip3 install "openv==$OPENV_VERSION"

if [ -d "$HOME/.openv" ]; then
    echo "ERROR: $HOME/.openv already exists. Remove it before running bootstrap."
    exit 1
fi

git clone "$DOTFILES_URL" "$HOME/.openv"

openv install
